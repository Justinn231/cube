# ── Pflicht ──────────────────────────────────────────────────────────────
# Telegram-Bot (via @BotFather anlegen), Chat-ID = deine private Chat-ID mit dem Bot.
# Ohne diese Werte läuft alles im "disabled mode" (Meldungen nur im Log) — gut zum Testen.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Kommando, das einen Worker-Zyklus ausführt. Der Prompt liegt in $PROMPT_FILE.
# Claude Code:
WORKER_CMD=claude -p "$(cat "$PROMPT_FILE")" --dangerously-skip-permissions
# Codex-Alternative:
# WORKER_CMD=codex exec --full-auto "$(cat "$PROMPT_FILE")"
WORKER_NAME=claude

# ── Optional (Defaults in Klammern) ──────────────────────────────────────
TZ=Europe/Berlin
CURRENCY=USD
DASHBOARD_PORT=8788          # Dashboard: http://127.0.0.1:8788 (nur localhost!)
DAILY_REPORT_HOUR=8          # Tagesreport ab dieser Stunde (lokale Zeit)
CYCLE_PAUSE_SECONDS=60       # Pause zwischen Zyklen
MAX_CYCLE_MINUTES=120        # Hard-Kill für hängende Zyklen
RATE_LIMIT_BACKOFF_MINUTES=30
MAX_BACKOFF_MINUTES=240
SPEND_APPROVAL_THRESHOLD=5   # Ausgaben > X brauchen Human-Approval via Relay
WAR_ROOM_WEEKDAY=0           # 0=Sonntag … 6=Samstag: erster Zyklus des Tages = Portfolio-Review

# ── Lokales Modell (optional, dritte Modell-Stufe zur Kostensenkung) ─────
# Voraussetzung: Ollama auf dem VPS (`curl -fsSL https://ollama.com/install.sh | sh`,
# dann `ollama pull <modell>`). Leer lassen = deaktiviert.
# RAM-Richtwerte (Q4/QAT, CPU-only): gemma3:1b-it-qat ~1 GB (sehr schwach),
# gemma3:4b-it-qat ~4 GB (Empfehlung für 8-GB-VPS), gemma3:12b-it-qat ~9 GB
# (braucht 16-GB-VPS), gemma3:27b-it-qat ~18 GB (nur mit GPU/32 GB sinnvoll).
OLLAMA_URL=http://127.0.0.1:11434
LOCAL_MODEL=
LOCAL_TIMEOUT_SECONDS=300

# ── Secrets für den Agenten (per Relay-Request nachpflegen) ──────────────
# STRIPE_SECRET_KEY=
# GITHUB_TOKEN=
# FAL_KEY=
